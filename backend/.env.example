# Copy this file to backend/.env and put your own VirusTotal API key after the =.
# backend/.env is git-ignored. Never commit a real key or paste it into chat.
VT_API_KEY=
# Send only scheme+host+path to VirusTotal (default true). Set false to send the full URL.
VT_STRIP_QUERY=true
# Free tier is 4 requests/minute: look up at most this many links per email (default 3)
VT_MAX_URLS=3
# Stop for the day after this many requests (free daily quota is 500; default 450)
VT_DAILY_CAP=450
